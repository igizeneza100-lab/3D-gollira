# API Base URL - Leave empty for development (localhost)
# For production, set to your domain: https://www.gorilla3dstudio.com
VITE_API_BASE_URL=

# Database URL - MongoDB connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
DATABASE_URL=

# Add these to your Vercel Environment Variables:
# VITE_API_BASE_URL=https://www.gorilla3dstudio.com
# DATABASE_URL=mongodb+srv://your-connection-string
